<templates>

    <t t-name="owl_todo.TodoApp">
        <div>
            <ControlPanel>
                <t t-set-slot="control-panel-navigation-additional">
                    <span t-if="this.todoPlugin.todos.length" class="badge text-bg-primary fs-6">
                        <t t-out="this.todoPlugin.doneCount()"/>/<t t-out="this.todoPlugin.todos.length"/> completed
                    </span>
                </t>
            </ControlPanel>
            <TodoInput/>
            <TodoList/>
        </div>
    </t>

</templates>

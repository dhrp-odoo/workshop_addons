<templates>

    <t t-name="owl_todo.TodoInput">
        <form class="d-flex gap-2 p-3" t-on-submit.prevent="this.onSubmit">
            <input class="form-control" placeholder="Add new todo" t-model="this.title"/>
            <t t-if="this.props.editingTodo">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary" t-on-click="this.props.onCancel">Cancel</button>
            </t>
            <button t-else="" type="submit" class="btn btn-primary">Add</button>
        </form>
    </t>

</templates>
